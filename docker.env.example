# Plantilla para el entorno LOCAL de Docker (Postgres + n8n).
# Copia este archivo a ".env.docker" y reemplaza los valores antes de
# levantar "docker compose --env-file .env.docker up -d".
# ".env.docker" ya está en .gitignore: nunca se sube a git.

# --- Postgres ---
POSTGRES_USER=meals_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=meals_db

# --- n8n (login de la interfaz web, no tiene relación con Postgres) ---
N8N_USER=admin
N8N_PASSWORD=changeme
